# ============================================================================
# Texas Bar Attorney Enrichment — Cloud & Local Runtime Configuration
# Copy this file to `.env` (`cp .env.example .env`) and fill in your GCP values
# ============================================================================

# ---- Storage Backend -------------------------------------------------------
# bigquery -> Google Cloud BigQuery dataset (production & cloud-connected mode)
STORAGE_BACKEND=bigquery

# ---- Google Cloud Platform (GCP) Credentials & Dataset ---------------------
# Replace with your GCP Project ID.
# Authenticate via `gcloud auth application-default login` OR provide a
# Service Account JSON key path in GOOGLE_APPLICATION_CREDENTIALS below.
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_DATASET=txbar
GCS_RAW_BUCKET=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ---- Scraper Politeness & Resilience ---------------------------------------
# robots.txt specifies Crawl-delay: 1. We stay politely above that with jitter.
SCRAPER_MIN_DELAY_S=1.2
SCRAPER_MAX_DELAY_S=2.8
SCRAPER_MAX_RETRIES=4
SCRAPER_TIMEOUT_S=30

# ---- Entity Resolution Thresholds ------------------------------------------
MATCH_AUTO_APPROVE=85
MATCH_REVIEW_FLOOR=55

# ---- Run-Level Data Quality Gate -------------------------------------------
DQ_MAX_NOT_FOUND_RATIO=0.20
DQ_MAX_MISSING_PHONE_RATIO=0.35

# ---- Review Console Security -----------------------------------------------
REVIEWER_TOKEN=change-me
