# ============================================================================
# Texas Bar Attorney Enrichment — Runtime Configuration
# Copy this file to `.env` (`cp .env.example .env`) and adjust as needed.
# ============================================================================

# ---- Storage Backend -------------------------------------------------------
# csv      -> Local CSV files under data/warehouse/ (default for local dev)
# bigquery -> Google Cloud BigQuery dataset (production / cloud mode)
STORAGE_BACKEND=csv

# ---- Google Cloud Platform (required when STORAGE_BACKEND=bigquery) --------
# Authenticate locally via `gcloud auth application-default login` or set
# GOOGLE_APPLICATION_CREDENTIALS to a Service Account JSON key path.
GCP_PROJECT_ID=
GCP_REGION=us-central1
BQ_DATASET=txbar
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Source & Data Paths ---------------------------------------------------
# DEFAULT_INPUT_CSV=data/input/tx_lawyers.csv
# RULES_DIR=data/rules
# SCHEMAS_DIR=schemas

# ---- Scraper Politeness & Resilience ---------------------------------------
# robots.txt specifies Crawl-delay: 1. We stay politely above that with jitter.
SCRAPER_MIN_DELAY_S=1.2
SCRAPER_MAX_DELAY_S=2.8
SCRAPER_MAX_RETRIES=4
SCRAPER_TIMEOUT_S=30
SCRAPER_MAX_DETAIL_FETCHES=4

# ---- Entity Resolution Thresholds ------------------------------------------
MATCH_AUTO_APPROVE=85
MATCH_REVIEW_FLOOR=55
MATCH_AMBIGUITY_DELTA=8

# ---- Run-Level Data Quality Gate -------------------------------------------
DQ_MAX_NOT_FOUND_RATIO=0.20
DQ_MAX_MISSING_PHONE_RATIO=0.35

# ---- Review Console Security -----------------------------------------------
# Leave empty to disable token auth in local dev; set a strong random token in prod.
REVIEWER_TOKEN=
