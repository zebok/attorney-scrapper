# ---- Storage -------------------------------------------------------------
# csv      -> local files under data/warehouse/ (same tables/columns as BigQuery)
# bigquery -> GCP dataset (requires `gcloud auth application-default login`)
STORAGE_BACKEND=csv
LOCAL_WAREHOUSE_DIR=data/warehouse

# ---- GCP (only for STORAGE_BACKEND=bigquery / deployment) ------------------
GCP_PROJECT_ID=txbar-attorney-pipeline
GCP_REGION=us-central1
BQ_DATASET=txbar
GCS_RAW_BUCKET=
# ---- Scraper politeness ---------------------------------------------------
# robots.txt asks for Crawl-delay: 1. We stay above that.
SCRAPER_MIN_DELAY_S=1.2
SCRAPER_MAX_DELAY_S=2.8
SCRAPER_MAX_RETRIES=4
SCRAPER_TIMEOUT_S=30
SCRAPER_USER_AGENT=RecruiterBackOffice-Research/1.0 (+contact: you@example.com)

# ---- Matching thresholds --------------------------------------------------
MATCH_AUTO_APPROVE=85
MATCH_REVIEW_FLOOR=55

# ---- Run-level data-quality gate -----------------------------------------
DQ_MAX_NOT_FOUND_RATIO=0.20
DQ_MAX_MISSING_PHONE_RATIO=0.20

# ---- Review UI -------------------------------------------------------------
# In Cloud Run this is injected from Secret Manager.
REVIEWER_TOKEN=change-me
